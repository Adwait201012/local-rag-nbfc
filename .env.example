POSTGRES_USER=rag
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rag

# Leave APP_PASSWORD empty to run without auth (local use only).
APP_PASSWORD=
SESSION_SECRET=change-this-to-something-random

LLM_MODEL=qwen3:8b
NUM_CTX=8192
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

TOP_K_CANDIDATES=40
TOP_K_FINAL=6
CHUNK_MAX_TOKENS=512

# Tesseract language packs are installed in the ingestion image.
OCR_LANGUAGES=eng,hin
# Enable for scans with a broken or misleading embedded text layer.
OCR_FORCE_FULL_PAGE=false

HF_CACHE=./models
OCR_CACHE=./ocr-models
